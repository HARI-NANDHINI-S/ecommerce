# .env.example
# Copy this file to .env and fill in the values.

# Supabase URLs and keys (public client)
PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Supabase service role (server-side only, never commit to source control)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Razorpay credentials (public key for client, secret for server)
PUBLIC_RAZORPAY_KEY_ID=YOUR_RAZORPAY_PUBLIC_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_KEY
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Site configuration (publicly visible, safe to expose)
PUBLIC_SITE_URL=https://yourstore.example.com
PUBLIC_STORE_NAME=Your Store Name
PUBLIC_SUPPORT_EMAIL=support@example.com
PUBLIC_PAYMENT_MODE=test # or live

# Email service (optional, server-side only)
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=no-reply@yourstore.example.com

# Additional optional variables
PUBLIC_LOGO_URL=https://yourstore.example.com/logo.png
PUBLIC_FAVICON_URL=https://yourstore.example.com/favicon.ico
